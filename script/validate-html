#!/usr/bin/env ruby
# frozen_string_literal: true

require "w3c_validators"

def validator(file)
  extension = File.extname(file)
  if extension == ".html"
    W3CValidators::NuValidator.new
  elsif extension == ".css"
    W3CValidators::CSSValidator.new
  end
end

def validate(file)
  puts "Checking #{file}..."

  path = File.expand_path "../_site/#{file}", __dir__
  results = validator(file).validate_file(path)

  return puts "Valid!" if results.errors.empty?

  results.errors.each { |err| puts err.to_s }
  exit 1
end

files = ["index.html"]

# Modern CSS features like custom properties and clamp() routinely trigger
# false-positives from the remote W3C CSS validator the theme used before.
# Keep the HTML validation in place for structural regressions while allowing
# maintainers to opt back into CSS checks locally if they really need them.
if ENV["VALIDATE_CSS"] == "true"
  files << File.join("assets", "css", "style.css")
end

files.each { |file| validate(file) }
