#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
REMOTE_NAME="${GITHUB_REMOTE:-origin}"
PAGES_BRANCH="${GITHUB_PAGES_BRANCH:-gh-pages}"
TMP_DIR="$(mktemp -d)"

cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

if ! git -C "$ROOT_DIR" remote get-url "$REMOTE_NAME" >/dev/null 2>&1; then
  echo "Remote '$REMOTE_NAME' is not configured. Set GITHUB_REMOTE to the remote you want to deploy to." >&2
  exit 1
fi

npm run build

cp -R "$ROOT_DIR/dist/." "$TMP_DIR"
cd "$TMP_DIR"

git init >/dev/null
# Using an orphan branch keeps the deployment history focused on built assets only.
git checkout --orphan "$PAGES_BRANCH" >/dev/null 2>&1 || git checkout -b "$PAGES_BRANCH" >/dev/null

git add .
GIT_AUTHOR_NAME="GitHub Pages Deploy" \
GIT_AUTHOR_EMAIL="deploy@local" \
GIT_COMMITTER_NAME="GitHub Pages Deploy" \
GIT_COMMITTER_EMAIL="deploy@local" \
git commit -m "Deploy site" >/dev/null

git remote add origin "$(git -C "$ROOT_DIR" remote get-url "$REMOTE_NAME")"
git push --force origin "$PAGES_BRANCH"
